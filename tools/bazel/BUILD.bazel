load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//tools/bazel:hdl.bzl", "unit_tests")

exports_files(
    ["comment_lint_main.py", "extensions.bzl", "hdl.bzl", "hdl_libraries.py", "pytest_main.py"],
    visibility = ["//visibility:public"],
)

# bazel test --//tools/bazel:waves <target>: rebuild models with tracing and write
# waveforms into the test's outputs (bazel-testlogs/<package>/<target>/test.outputs/).
bool_flag(
    name = "waves",
    build_setting_default = False,
)

config_setting(
    name = "waves_on",
    flag_values = {":waves": "true"},
    visibility = ["//visibility:public"],
)

# The board image action's entry point (hdl.bzl quartus_image).
py_binary(
    name = "quartus_image",
    srcs = ["quartus_image.py"],
    visibility = ["//visibility:public"],
)

unit_tests()
