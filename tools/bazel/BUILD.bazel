load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//tools/bazel:hdl.bzl", "unit_tests")

exports_files(
    ["comment_lint_main.py", "extensions.bzl", "hdl.bzl", "hdl_libraries.py", "pytest_main.py", "rtl_lint_main.py",
     "wiki_refs_main.py"],
    visibility = ["//visibility:public"],
)

# bazel test --//tools/bazel:waves <target>: rebuild models with tracing and write
# waveforms into the test's outputs (bazel-testlogs/<package>/<target>/test.outputs/).
bool_flag(
    name = "waves",
    build_setting_default = False,
)

config_setting(
    name = "waves_on",
    flag_values = {":waves": "true"},
    visibility = ["//visibility:public"],
)

# bazel test --//tools/bazel:coverage <target>: rebuild models with Verilator's
# --coverage and write each test's code coverage (coverage.dat, an lcov
# coverage.info, annotated sources) and its summary into the test's outputs.
bool_flag(
    name = "coverage",
    build_setting_default = False,
)

config_setting(
    name = "coverage_on",
    flag_values = {":coverage": "true"},
    visibility = ["//visibility:public"],
)

# The board image action's entry point (hdl.bzl quartus_image).
py_binary(
    name = "quartus_image",
    srcs = ["quartus_image.py"],
    visibility = ["//visibility:public"],
)

# The scratch checkout every unit test may run code against (hdl.bzl unit_tests).
py_library(
    name = "scratch",
    srcs = ["scratch.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

# Why: the board image action's test runs its entry point as Bazel builds it.
unit_tests(data = [":quartus_image"])
