# Board host cables, readable and writable without root by the desktop user and
# the CI runner's user service: the USB-Blaster variants (DE2-115, DE10-Lite)
# and the FTDI TTL-232R UART cable. Install: wiki/tools/toolchain/spec.md#boards.
SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6001", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6010", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6810", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666"
