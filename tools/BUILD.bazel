load("//tools/bazel:hdl.bzl", "unit_tests")
load("@rules_python//python:py_library.bzl", "py_library")
load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:py_test.bzl", "py_test")

# The tools' Python that tests import (tools.board, ...); tools with their own
# package (sim, bazel) are not part of it.
py_library(
    name = "python",
    srcs = glob(["**/*.py"]),
    data = glob(["**"], exclude = ["**/*.py", "BUILD.bazel"]),
    imports = [".."],
    visibility = ["//visibility:public"],
)

# The Quartus build tool, as the board image action runs it (hdl.bzl quartus_image).
exports_files(["quartus/quartus.py"], visibility = ["//visibility:public"])

filegroup(
    name = "quartus_files",
    srcs = glob(["quartus/*.py"]),
    visibility = ["//visibility:public"],
)

# Why: the board console's app runs on Textual, so its tests import it.
unit_tests(deps = [requirement("textual")])

# The comment lint as an L0 test. CI writes the base branch's baseline to
# workdir/lint/base-baseline.json first; without it the lint checks this tree only.
py_test(
    name = "comment_lint",
    srcs = ["//tools/bazel:comment_lint_main.py"],
    main = "//tools/bazel:comment_lint_main.py",
    deps = [":python"],
    args = ["--base-baseline", "workdir/lint/base-baseline.json"],
    # Why: it lists the checkout's tracked files with git, which no sandbox or cache sees.
    tags = ["L0", "external", "no-sandbox", "lint"],
)

# The wiki reference check as an L0 test: every wiki/ path cited outside wiki/ exists.
py_test(
    name = "wiki_refs",
    srcs = ["//tools/bazel:wiki_refs_main.py"],
    main = "//tools/bazel:wiki_refs_main.py",
    deps = [":python"],
    # Why: it lists the checkout's tracked files with git and reads the whole tree, which no sandbox or cache sees.
    tags = ["L0", "external", "no-sandbox", "lint"],
)
