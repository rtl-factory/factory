# Bazel output locations (logs, waveforms, reports, netlists)
/bazel-*

# Wiki site build output (mkdocs build)
/site/

# Python bytecode
__pycache__/

# Scratch output of simulations, Quartus builds and tools
/workdir/

# Cartridge images and private content: never add by accident. The one
# tracked ROM and its README were added on purpose (see
# src/nand2mario/sw/roms/private/README.md); do not loosen these rules.
*.gb
*.gbc
private/

# Machine-only Bazel settings (registry mirror, cache paths)
/user.bazelrc

# Bazel lockfile: resolution is pinned by MODULE.bazel; the lockfile records the
# registry mirror each host used.
/MODULE.bazel.lock
