{
  "schema": "n2a-board/1",
  "project": "nand2mario",
  "program": {"label": "Cartridge image", "patterns": ["*.gb", "*.bin"],
              "default": "src/nand2mario/sw/roms/private/super-mario-land-rev1.gb"},
  "pad": {"Up": "Up", "Down": "Down", "Left": "Left", "Right": "Right", "A": "x", "B": "z",
          "Select": "space", "Start": "Return"},
