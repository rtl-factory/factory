# Formal setup for n2a_sdram_ctrl, nand2mario configuration. Plan and results:
# wiki/src/common/fv/sdram/fv-plan.md. Run: python3 tools/fv/fv.py run n2a_sdram_ctrl_word
# level: L0
# timeout: 600
# library: n2a_sdram_ctrl_fv
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 64

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
read_slang --no-synthesis-define -I . -G LINE=0 {sources} --top n2a_sdram_ctrl_fv
prep -top n2a_sdram_ctrl_fv
flatten
techmap
opt -fast
setundef -undriven -anyseq
setundef -anyseq
