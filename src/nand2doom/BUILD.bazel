load("@pypi//:requirements.bzl", "requirement")
load("//tools/bazel:hdl.bzl", "hdl_project", "quartus_image", "unit_tests")

# Every simulation target of cfg/targets.json, and the project's files
# (wiki/tools/bazel/spec.md).
hdl_project(
    name = "nand2doom",
    # Why: the Doom build builds Picolibc from its pinned source with Meson and Ninja (#231).
    python_deps = [requirement("meson"), requirement("ninja")],
    # Why: the C-program tests build with the pinned RV32 GCC, not the host's (#226).
    rv32_gcc = True,
)

# The unit tests of the project's scripts.
unit_tests(rv32_gcc = True)

# Board images: bazel build //src/nand2doom:<board>_image on a host with Quartus.
quartus_image(
    name = "de10_lite_image",
    manifest = "src/nand2doom/cfg/n2d_quartus.json",
    project = "n2d_de10_lite",
)

quartus_image(
    name = "de2_115_image",
    board = "de2_115",
    manifest = "src/nand2doom/cfg/n2d_quartus.json",
    project = "n2d_de2_115",
)
