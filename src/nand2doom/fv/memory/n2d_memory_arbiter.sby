# Formal setup for n2d_memory_arbiter. Plan and results:
# wiki/src/nand2doom/fv/memory/fv-plan.md. Run: python3 tools/fv/fv.py run n2d_memory_arbiter
# level: L0
# timeout: 600
# library: n2d_memory_arbiter_fv
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 16

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read_slang --no-synthesis-define -I . {sources} --top n2d_memory_arbiter_fv
prep -top n2d_memory_arbiter_fv
flatten
techmap
opt -fast
setundef -undriven -anyseq
setundef -anyseq
