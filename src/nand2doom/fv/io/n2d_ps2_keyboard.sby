# Formal setup for the n2d_ps2_keyboard event FIFO. Plan and results:
# wiki/src/nand2doom/fv/io/fv-plan.md. Run: python3 tools/fv/fv.py run n2d_ps2_keyboard
# level: L0
# timeout: 600
# library: n2d_ps2_keyboard_fv
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 40

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read_slang --no-synthesis-define -I . {sources} --top n2d_ps2_keyboard_fv
prep -top n2d_ps2_keyboard_fv
flatten
techmap
opt -fast
setundef -undriven -anyseq
setundef -anyseq
