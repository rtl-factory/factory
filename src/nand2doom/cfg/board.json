                  "sof": "workdir/quartus/n2d_de10_lite/output_files/n2d_de10_lite.sof"},
    "de2_115": {"idcode": "020F70DD", "baud": 2000000,
                "sof": "workdir/quartus/n2d_de2_115/output_files/n2d_de2_115.sof"}
  }
}
