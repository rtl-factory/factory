{
  "schema": "n2a-board/1",
  "project": "nand2doom",
  "program": {"label": "Image manifest", "patterns": ["manifest.json", "*.json"],
              "default": "workdir/software/n2d_doom/manifest.json"},
  "pad": {"Up": "Up", "Down": "Down", "Left": "Left", "Right": "Right", "Fire": "Control_L",
          "Use": "space", "Run": "Shift_L", "Strafe": "Alt_L", "Enter": "Return", "Menu": "Escape",
          "Map": "Tab", "Yes": "y"},
  "aliases": {"f": "Control_L", "d": "Alt_L", "r": "Shift_L"},
  "load": ["{python}", "src/common/scripts/uart_mem/uart_mem_load.py", "{program}",
           "--project", "n2d ", "--port", "{port}", "--baud", "{baud}", "--skip-unchanged", "--yes"],
  "boards": {
    "de10_lite": {"idcode": "031050DD", "baud": 2000000,
                  "sof": "workdir/quartus/n2d_de10_lite/output_files/n2d_de10_lite.sof"},
    "de2_115": {"idcode": "020F70DD", "baud": 2000000,
                "sof": "workdir/quartus/n2d_de2_115/output_files/n2d_de2_115.sof"}
  }
}
